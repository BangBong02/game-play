---
import PlantArt from './PlantArt.astro';
interface Props {
  name: string;
  description: string;
  icon: string;
  color?: string;
  href?: string;
  subtitle?: string;
  detail?: string;
  variant?: 'level' | 'topic' | 'skill';
  progressKey?: string;
  action?: string;
  compact?: boolean;
}
const { name, description, icon, href, subtitle, detail, color = 'green', variant = 'topic', progressKey, action, compact = false } = Astro.props;
const Tag = href ? 'a' : 'article';
---
<Tag href={href} class:list={['learning-card', color, variant, { unavailable: !href }]}>
  {variant === 'level' ? <>
    <div class="card-top"><span class="small-label">{name === 'Easy' ? 'Start here' : name === 'Medium' ? 'Keep growing' : 'Take a challenge'}</span><span class="card-arrow" aria-hidden="true">→</span></div>
    <PlantArt kind={icon} />
    <h3>{name}</h3>
    <strong class="level-word-count">{subtitle}</strong>
    <p>{description}</p>
    <span class="card-detail">{detail}</span>
    <span class="card-action">Play {name} <span aria-hidden="true">→</span></span>
  </> : <>
    <div class="card-top"><span class="topic-icon" aria-hidden="true">{icon}</span><span class="status-label">{href ? subtitle || 'Ready to play' : 'Coming soon'}</span></div>
    <h3>{name}</h3>
    {!compact && <p>{description}</p>}
    {href && <>
      {progressKey && <div class="topic-progress" data-progress={progressKey} hidden><span data-progress-label></span><progress max="1" value="0" aria-label={`${name} progress`}></progress></div>}
      <span class="topic-action" data-topic-action={progressKey}><span data-action-label>{action || (variant === 'skill' ? 'Play now' : 'Play')}</span><span aria-hidden="true">→</span></span>
    </>}
  </>}
</Tag>
