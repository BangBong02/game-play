---
interface Props { name: string; description: string; icon: string; color: string; href: string; action: string }
const { name, description, icon, color, href, action } = Astro.props;
---
<a href={href} class:list={['learning-card', color]}><span class="topic-icon" aria-hidden="true">{icon}</span><h2>{name}</h2><p>{description}</p><span class="topic-action">{action} <span aria-hidden="true">→</span></span></a>
