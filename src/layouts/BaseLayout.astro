---
import '../styles/global.css';
import { locales, localePath, messages, type Locale } from '../i18n';
interface Props { title: string; description?: string; locale?: Locale }
const { title, locale = 'en' } = Astro.props;
const t = messages[locale];
const description = Astro.props.description ?? t.hero;
const home = `/${locale}`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} /><meta name="theme-color" content="#fffaf0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {canonical && <link rel="canonical" href={canonical.href} />}
    {canonical && locales.map(code => <link rel="alternate" hreflang={code} href={new URL(localePath(code, Astro.url.pathname === '/404' ? home : Astro.url.pathname), Astro.site).href} />)}
    <title>{title} · Lingoplay</title>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <header class="site-header"><div class="header-inner">
      <a class="brand" href={home} aria-label="Lingoplay"><span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>lingo<span>play</span><span class="brand-dot">.</span></a>
      <nav aria-label={t.navigation}><a class="nav-link" href={home}>{t.games}</a><a class="nav-link" href={`${home}/learn`}>{t.learn}</a></nav>
      <div class="locale-switch" aria-label={t.uiLanguage}>{locales.map(code => <a data-locale href={localePath(code, Astro.url.pathname === '/404' ? home : Astro.url.pathname)} lang={code} aria-current={code === locale ? 'true' : undefined}>{code.toUpperCase()}</a>)}</div>
    </div></header>
    <main id="main"><slot /></main>
    <footer class="site-footer"><a class="footer-brand" href={home}>lingoplay.</a><span>{t.footer}</span><a class="library-link" href={`${home}/learn`}>{t.library} →</a></footer>
    <script>
      document.querySelectorAll<HTMLAnchorElement>('[data-locale]').forEach(link => { link.href += window.location.search + window.location.hash; });
    </script>
  </body>
</html>
