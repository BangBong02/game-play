---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { coursePath } from '../../../../config/course';
import { locales, messages, learningLanguage } from '../../../../i18n';
import { contentSections } from '../../../../config/content';

export async function getStaticPaths() {
  const routes = [];
  for (const locale of locales) {
    for (const section of contentSections) {
      const entries = await getCollection(section.id, ({ data }) => data.language === learningLanguage && !data.draft);
      routes.push({ params: { locale, collection: section.id, id: undefined }, props: { locale, section, entries, entry: undefined } });
      for (const entry of entries) {
        routes.push({ params: { locale, collection: section.id, id: entry.id }, props: { locale, section, entries, entry } });
      }
    }
  }
  return routes;
}

const { locale, section, entries, entry } = Astro.props;
const t = messages[locale];
const sectionName = t.sections[section.id];
const sectionDescription = t.sectionDescriptions[section.id];
const sectionPath = coursePath(locale, 'learn', section.id);
---
<BaseLayout title={entry?.data.title || sectionName} description={entry?.data.description || sectionDescription} locale={locale}>
  <div class="page-container interior-page">
    <nav class="breadcrumbs" aria-label={t.navigation}>
      <a href={coursePath(locale)}>{t.games}</a><span aria-hidden="true">/</span>
      <a href={coursePath(locale, 'learn')}>{t.library}</a><span aria-hidden="true">/</span>
      {entry ? <><a href={sectionPath}>{sectionName}</a><span aria-hidden="true">/</span><span aria-current="page">{entry.data.title}</span></> : <span aria-current="page">{sectionName}</span>}
    </nav>
    <header class="page-heading reading-width">
      <span class:list={['pill', section.color]}>{t.library} · {sectionName}</span>
      <h1 lang={entry ? learningLanguage : locale}>{entry?.data.title || sectionName}</h1>
      <p lang={entry ? learningLanguage : locale}>{entry?.data.description || sectionDescription}</p>
    </header>
    {entry ? <>
      <p class="reading-width notice">{t.articleLanguage}</p>
      <article lang="en" class="prose reading-width" aria-label={entry.data.title}>
        {entry.data.sections.map(block => <section>
          <h2>{block.heading}</h2>
          {block.paragraphs.map(paragraph => <p>{paragraph}</p>)}
          {block.examples.length > 0 && <ul>{block.examples.map(example => <li>{example}</li>)}</ul>}
        </section>)}
      </article>
      <div class="reading-width article-links"><a class="back-link" href={sectionPath}>← {t.more}</a><a class="back-link" href={coursePath(locale)}>{t.games} →</a></div>
    </> : <>
      <div class="article-list reading-width">
        {entries.map(article => <a href={`${sectionPath}/${article.id}`} class="article-card">
          <h2 lang="en">{article.data.title}</h2><p lang="en">{article.data.description}</p><span>{t.read} <span aria-hidden="true">→</span></span>
        </a>)}
      </div>
      {entries.length === 0 && <a class="back-link reading-width" href={coursePath(locale)}>{t.games} →</a>}
    </>}
  </div>
</BaseLayout>
