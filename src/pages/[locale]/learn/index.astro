---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import LearningCard from '../../../components/LearningCard.astro';
import { contentSections } from '../../../config/content';
import { locales, messages } from '../../../i18n';
import { topicLabel, learningLanguage } from '../../../i18n';
import { topicRepository, wordRepository } from '../../../repositories/content';
export function getStaticPaths() { return locales.map(locale => ({ params: { locale }, props: { locale } })); }
const { locale } = Astro.props;
const t = messages[locale];
const [topics, words] = await Promise.all([topicRepository.list(learningLanguage), wordRepository.forGame({ game: 'word-to-meaning', startRank: 1 })]);
---
<BaseLayout title={t.library} locale={locale}>
  <div class="page-container interior-page"><header class="page-heading"><h1>{t.library}</h1><p>{t.libraryIntro}</p></header>
    <div class="content-grid">{contentSections.map(section => <LearningCard name={t.sections[section.id]} description={t.sectionDescriptions[section.id]} icon={section.icon} color={section.color} href={`/${locale}/learn/${section.id}`} action={t.read} />)}</div>
    <section class="vocabulary-library"><h2>{t.wordList}</h2><div class="content-grid">{topics.map(topic => { const count = words.filter(word => word.curriculum === 'oxford-3000' && word.topics.includes(topic.id)).length; return count > 0 && <LearningCard name={topicLabel(locale, topic.id)} description={`${count} ${t.availableDemo}`} icon={topic.icon} color={topic.color} href={`/${locale}/learn/vocabulary/${topic.id}`} action={t.wordList} />; })}</div></section>
  </div>
</BaseLayout>
