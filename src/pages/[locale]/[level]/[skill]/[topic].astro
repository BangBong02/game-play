---
import { locales } from '../../../../i18n';
import { levels } from '../../../../config/course';
import { topics } from '../../../../data/content';
export function getStaticPaths() { return locales.flatMap(locale => levels.flatMap(level => topics.map(topic => ({ params: { locale, level: level.id, skill: 'vocabulary', topic: topic.id } })))); }
return Astro.redirect(`/${Astro.params.locale}/games/word-match?topic=${encodeURIComponent(Astro.params.topic!)}`);
---
