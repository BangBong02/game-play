---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import LearningCard from '../../../components/LearningCard.astro';
import { languages, levels, skills, coursePath } from '../../../config/course';
export function getStaticPaths() { return languages.flatMap(language => levels.map(level => ({ params: { language: language.id, level: level.id }, props: { language, level } }))); }
const { language, level } = Astro.props;
---
<BaseLayout title={`${level.name} ${language.name} games`} language={language.id}>
  <div class="page-container interior-page">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href={coursePath(language.id)}>{language.name}</a><span aria-hidden="true">/</span><span aria-current="page">{level.name}</span></nav>
    <header class:list={['page-heading', 'level-heading', level.color]}><span class="pill">{language.name} · {level.name}</span><h1>{level.name}<span class="heading-dot">.</span></h1><strong class="heading-word-count">{level.subtitle}</strong><p>{level.description}. Choose a skill and let's play.</p></header>
    <div class="section-heading"><h2>Choose a skill</h2><span class="section-aside">Vocabulary is ready. Jump in!</span></div>
    <div class="content-grid">{skills.map(skill => <LearningCard {...skill} variant="skill" color={skill.available ? level.color : 'neutral'} href={skill.available ? coursePath(language.id, level.id, skill.id) : undefined} />)}</div>
    <p class="demo-note">Vocabulary is ready to explore. More ways to play are on the way.</p>
  </div>
</BaseLayout>
