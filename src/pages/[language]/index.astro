---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LearningCard from '../../components/LearningCard.astro';
import { languages, levels, coursePath } from '../../config/course';
export function getStaticPaths() { return languages.map(language => ({ params: { language: language.id }, props: { language } })); }
const { language } = Astro.props;
---
<BaseLayout title={`${language.name} games — Learn through play`} language={language.id}>
  <div class="page-container home-page">
    <section class="hero" aria-labelledby="hero-title">
      <span class="eyebrow"><span class="live-dot"></span> YOUR NEXT LITTLE ADVENTURE</span>
      <h1 id="hero-title">Big learning.<br /><span>Little games.</span><svg class="hero-spark" viewBox="0 0 55 55" aria-hidden="true"><path d="M27 3V17M27 38V52M3 27H17M38 27H52M10 10L20 20M35 35L45 45M10 45L20 35M35 20L45 10" stroke="currentColor" stroke-width="4" stroke-linecap="round" /></svg></h1>
      <p>A playful way to make {language.name} part of your everyday.<br class="desktop-break" /> Pick your level. Find your rhythm. Let curiosity do the rest.</p>
      <div class="hero-notes"><span><span aria-hidden="true">✓</span> Bite-sized games</span><span><span aria-hidden="true">✓</span> Your own pace</span><span><span aria-hidden="true">✓</span> No pressure</span></div>
      <span class="hero-doodle doodle-left" aria-hidden="true">a<span>↗</span></span><span class="hero-doodle doodle-right" aria-hidden="true">hello<span>✦</span></span>
    </section>
    <section aria-labelledby="levels-title">
      <div class="section-heading"><div><span class="eyebrow">A PLACE TO START</span><h2 id="levels-title">Choose your adventure</h2></div><span class="section-aside">Every great journey starts with a word.</span></div>
      <div class="level-grid">{levels.map(level => <LearningCard {...level} href={coursePath(language.id, level.id)} variant="level" />)}</div>
      <p class="demo-note"><span aria-hidden="true">✧</span> A small taste of what's growing. Try 20 demo words across 3 topics.</p>
    </section>
    <section class="how-section" id="how-it-works" aria-labelledby="how-title">
      <div class="how-intro"><span class="eyebrow">LESS STUDYING, MORE DISCOVERING</span><h2 id="how-title">A few minutes.<br />A little more you know.</h2></div>
      <ol class="how-steps"><li><span class="step-number">01</span><h3>Find your starting point</h3><p>Choose a level that feels right. You can always explore another.</p></li><li><span class="step-number">02</span><h3>Play with new words</h3><p>Pick a topic and learn through a quick, friendly game.</p></li><li><span class="step-number">03</span><h3>Come back & grow</h3><p>Your progress stays on this device. Little by little adds up.</p></li></ol>
    </section>
  </div>
</BaseLayout>
