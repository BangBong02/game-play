---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import LearningCard from '../../../components/LearningCard.astro';
import { languages, coursePath } from '../../../config/course';
import { contentSections } from '../../../config/content';

export function getStaticPaths() {
  return languages.map(language => ({ params: { language: language.id }, props: { language } }));
}

const { language } = Astro.props;
---
<BaseLayout title={`${language.name} learning library`} description={`Explore ${language.name} grammar explanations, learning guides, and blog articles alongside your vocabulary games.`} language={language.id}>
  <div class="page-container interior-page">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href={coursePath(language.id)}>{language.name}</a><span aria-hidden="true">/</span><span aria-current="page">Learning library</span>
    </nav>
    <header class="page-heading">
      <span class="eyebrow">A LITTLE MORE TO DISCOVER</span>
      <h1>Read, learn, play<span class="heading-dot">.</span></h1>
      <p>Take a moment to explore the ideas behind the words.</p>
    </header>
    <div class="content-grid">
      {contentSections.map(section => <LearningCard {...section} href={coursePath(language.id, 'learn', section.id)} subtitle="Read & learn" action="Explore articles" />)}
    </div>
  </div>
</BaseLayout>
