---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { languages, coursePath } from '../../../../config/course';
import { contentSections } from '../../../../config/content';

export async function getStaticPaths() {
  const routes = [];
  for (const language of languages) {
    for (const section of contentSections) {
      const entries = await getCollection(section.id, ({ data }) => data.language === language.id && !data.draft);
      routes.push({ params: { language: language.id, collection: section.id, id: undefined }, props: { language, section, entries, entry: undefined } });
      for (const entry of entries) {
        routes.push({ params: { language: language.id, collection: section.id, id: entry.id }, props: { language, section, entries, entry } });
      }
    }
  }
  return routes;
}

const { language, section, entries, entry } = Astro.props;
const sectionPath = coursePath(language.id, 'learn', section.id);
---
<BaseLayout title={entry?.data.title || `${language.name} ${section.name}`} description={entry?.data.description || section.description} language={language.id}>
  <div class="page-container interior-page">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href={coursePath(language.id)}>{language.name}</a><span aria-hidden="true">/</span>
      <a href={coursePath(language.id, 'learn')}>Learning library</a><span aria-hidden="true">/</span>
      {entry ? <><a href={sectionPath}>{section.name}</a><span aria-hidden="true">/</span><span aria-current="page">{entry.data.title}</span></> : <span aria-current="page">{section.name}</span>}
    </nav>
    <header class="page-heading reading-width">
      <span class:list={['pill', section.color]}>{language.name} · {section.name}</span>
      <h1>{entry?.data.title || section.name}</h1>
      <p>{entry?.data.description || section.description}</p>
    </header>
    {entry ? <>
      <article class="prose reading-width" aria-label={entry.data.title}>
        {entry.data.sections.map(block => <section>
          <h2>{block.heading}</h2>
          {block.paragraphs.map(paragraph => <p>{paragraph}</p>)}
          {block.examples.length > 0 && <ul>{block.examples.map(example => <li>{example}</li>)}</ul>}
        </section>)}
      </article>
      <div class="reading-width article-links"><a class="back-link" href={sectionPath}>← More {section.name.toLowerCase()}</a><a class="back-link" href={coursePath(language.id)}>Explore vocabulary games →</a></div>
    </> : <>
      <div class="article-list reading-width">
        {entries.map(article => <a href={`${sectionPath}/${article.id}`} class="article-card">
          <h2>{article.data.title}</h2><p>{article.data.description}</p><span>Read article <span aria-hidden="true">→</span></span>
        </a>)}
      </div>
      {entries.length === 0 && <p class="reading-width">New articles are on the way. Explore a vocabulary game while you wait.</p>}
    </>}
  </div>
</BaseLayout>
